<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Script file="ItemButton.lua" />
    <Button name="GuildBankLayoutsItemButtonTemplate" mixin="GuildBankLayoutsItemButtonMixin"
        registerForClicks="AnyDown"
        virtual="true">
        <Size x="45" y="45" />
        <NormalTexture atlas="bags-item-slot64" />
        <HighlightTexture atlas="perks-border-square-gold">
            <Anchors>
                <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="-2" y="2" />
                <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="2" y="-2" />
            </Anchors>
        </HighlightTexture>
        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="count" inherits="NumberFontNormalSmall"
                    justifyH="RIGHT" justifyV="MIDDLE">
                    <Anchors>
                        <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="-2" y="2" />
                    </Anchors>
                </FontString>
                <Texture parentKey="tier" alpha="0.8" hidden="true">
                    <Size x="15" y="15" />
                    <Anchors>
                        <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="2" y="-2" />
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK" textureSubLevel="0">
                <Texture parentKey="icon">
                    <TexCoords left="0.1" right="0.9" top="0.1" bottom="0.9" />
                </Texture>
                <MaskTexture parentKey="iconMask"
                    file="Interface\Common\common-iconmask"
                    hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.icon" />
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.icon" />
                    </Anchors>
                    <MaskedTextures>
                        <MaskedTexture childKey="icon" />
                    </MaskedTextures>
                </MaskTexture>
            </Layer>
            <Layer level="ARTWORK" textureSubLevel="1">
                <Texture atlas="perks-border-square-gray">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="-2" y="2" />
                        <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="2" y="-2" />
                    </Anchors>
                </Texture>
            </Layer>

        </Layers>
        <Scripts>
            <OnClick method="OnClick" />
            <OnMouseWheel method="OnMouseWheel" />
        </Scripts>
    </Button>


    <Frame name="GuildBankLayoutsItemButtonGroupTemplate" virtual="true">
        <Size x="110" y="362" />
        <Frames>
            <Button inherits="GuildBankLayoutsItemButtonTemplate" parentKey="itemButton1">
