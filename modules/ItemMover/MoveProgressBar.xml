<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <StatusBar name="GuildBankLayoutsMoveProgressBar" minValue="0" maxValue="1000"
        orientation="HORIZONTAL" alpha="0" hidden="true">
        <Size x="200" y="20" />
        <Anchors>
            <Anchor point="CENTER" relativePoint="CENTER" x="0" y="-10" />
        </Anchors>
        <BarTexture atlas="delves-dashboard-bar-fill" desaturated="true">
            <Color r="1" g="0.83" b="0" />
            <Anchors>
                <Anchor point="BOTTOM" x="0" y="10" />
            </Anchors>
        </BarTexture>
        <Layers>
            <Layer level="BORDER">
                <Texture atlas="delves-dashboard-bar-border">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="1" y="-1" />
                        <Anchor point="BOTTOMRIGHT" x="0" y="1" />
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <FontString parentKey="text" inherits="GameFontHighlight" text="0%">
                    <Anchors>
                        <Anchor point="CENTER" x="0" y="0" />
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Animations>
            <AnimationGroup parentKey="FadeIn" setToFinalAlpha="true">
                <Alpha parentKey="Fade" duration="0.2" order="2"
                    fromAlpha="0" toAlpha="1" />
            </AnimationGroup>
            <AnimationGroup parentKey="FadeOut" setToFinalAlpha="true">
                <Translation parentKey="TranslateInit" duration="0" order="1" offsetY="0" />
                <Alpha parentKey="Fade" duration="0.2" order="2"
                    fromAlpha="1" toAlpha="0" />
                <Translation parentKey="Translate" duration="0.4" order="2" offsetY="-10"
                    smoothing="OUT" />
            </AnimationGroup>
        </Animations>
        <Scripts>
            <OnLoad>
                C_Timer.After(5, function()
                    self.FadeIn:Play()
                end)
                C_Timer.After(10, function()
                    self.FadeOut:Play()
                end)
            </OnLoad>
        </Scripts>
    </StatusBar>
</Ui>
