    <Script file="ItemButton.lua" />
    <Button name="GuildBankToolsItemButtonTemplate" mixin="GuildBankToolsItemButtonMixin"
        virtual="true">
        <Size x="45" y="45" />
        <NormalTexture atlas="bags-item-slot64" />
        <HighlightTexture atlas="perks-border-square-gold">
            <Anchors>
                <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="-2" y="2" />
                <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="2" y="-2" />
            </Anchors>
        </HighlightTexture>
        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="count" inherits="NumberFontNormalSmall" text="0"
                    justifyH="RIGHT" justifyV="MIDDLE">
                    <Anchors>
                        <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="-2" y="2" />
                    </Anchors>
                </FontString>
                <Texture parentKey="tier" atlas="Professions-Icon-Quality-Tier4" alpha="0.8">
                    <Size x="15" y="15" />
                    <Anchors>
                        <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="2" y="-2" />
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <Texture atlas="perks-border-square-gray">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="-2" y="2" />
                        <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="2" y="-2" />
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
    </Button>


