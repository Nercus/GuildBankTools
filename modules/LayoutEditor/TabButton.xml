<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Script file="TabButton.lua" />

    <Button name="GuildBankToolsLayoutEditorTabTemplate" virtual="true" alpha="0.8"
        mixin="GuildBankToolsLayoutEditorTabMixin">
        <Layers>
            <Layer level="BACKGROUND">
                <Texture
                    parentKey="left"
                    atlas="common-search-border-left">
                    <Size x="4" />
                    <Anchors>
                        <Anchor point="TOPLEFT" />
                        <Anchor point="BOTTOMLEFT" />
                    </Anchors>
                </Texture>
                <Texture
                    parentKey="right"
                    atlas="common-search-border-right">
                    <Size x="4" />
                    <Anchors>
                        <Anchor point="TOPRIGHT" />
                        <Anchor point="BOTTOMRIGHT" />
                    </Anchors>
                </Texture>
                <Texture
                    parentKey="middle" horizTile="true"
                    atlas="common-search-border-middle">
                    <Size x="2" />
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.left" relativePoint="TOPRIGHT"></Anchor>
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.right"
                            relativePoint="BOTTOMLEFT"></Anchor>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="active"
                    atlas="pvpqueue-button-casual-selected"
                    alpha="0.7" hidden="true" setAllPoints="true" alphaMode="ADD" />
            </Layer>
            <Layer level="HIGHLIGHT">
                <Texture parentKey="highlight"
                    horizTile="true"
                    atlas="ClickCastList-ButtonHighlight"
                    alpha="0.3">
                    <Size x="2" />
                    <Anchors>
                        <Anchor point="TOPLEFT" x="2" />
                        <Anchor point="BOTTOMRIGHT" x="-2" />
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <Texture parentKey="icon"
                    atlas="common-icon-checkmark-yellow"
                    hidden="true">
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnMouseDown>
                if not self:IsEnabled() then return end
                self:SetAlpha(1)
            </OnMouseDown>
            <OnMouseUp>
                if not self:IsEnabled() then return end
                self:SetAlpha(0.8)
            </OnMouseUp>
            <OnSizeChanged>
                local height = self:GetHeight()
                local leftAtlasInfo = C_Texture.GetAtlasInfo(self.left:GetAtlas())
                local rightAtlasInfo = C_Texture.GetAtlasInfo(self.right:GetAtlas())
                if leftAtlasInfo and rightAtlasInfo then
                    local leftWidth = leftAtlasInfo.width / leftAtlasInfo.height * height
                    local rightWidth = rightAtlasInfo.width / rightAtlasInfo.height * height
                    self.left:SetWidth(leftWidth)
                    self.right:SetWidth(rightWidth)
                end
                self.left:SetHeight(height)
                self.right:SetHeight(height)
                self.middle:SetHeight(height)
            </OnSizeChanged>
            <OnDisable>
                self.left:SetDesaturated(true)
                self.right:SetDesaturated(true)
                self.middle:SetDesaturated(true)
                self.left:SetAlpha(0.5)
                self.right:SetAlpha(0.5)
                self.middle:SetAlpha(0.5)
                self.highlight:SetAlpha(0)
            </OnDisable>
            <OnEnable>
                self.left:SetDesaturated(false)
                self.right:SetDesaturated(false)
                self.middle:SetDesaturated(false)
                self.left:SetAlpha(0.8)
                self.right:SetAlpha(0.8)
                self.middle:SetAlpha(0.8)
                self.highlight:SetAlpha(1)
            </OnEnable>
            <OnLoad>
                if not self.iconTexture then return end
                local height = self:GetHeight()
                local fontString = self:GetFontString()
                if fontString then
                    fontString:ClearAllPoints()
                    fontString:SetPoint("CENTER", (height - 15) / 2, 0)
                end
                if self.iconTexture then
                    self.icon:SetSize(height - 15, height - 15)
                    self.icon:ClearAllPoints()
                    if fontString then
                        self.icon:SetPoint("RIGHT", fontString, "LEFT", -3, 0)
                    else
                        self.icon:SetPoint("CENTER")
                    end
                    self.icon:SetTexture(self.iconTexture)
                    self.icon:Show()
                end
                self:SetInactive()
            </OnLoad>
            <OnClick>
                if not self:IsEnabled() then return end
                if self.isActive then
                    self:SetInactive()
                else
                    self:SetActive()
                end
            </OnClick>
        </Scripts>
        <NormalFont style="GameFontNormal" />
        <DisabledFont style="GameFontDisable" />
    </Button>
</Ui>
